{
  "name": "trpc-runner",
  "version": "0.0.1",
  "description": "Backend-mounted UI for inspecting and running tRPC procedures",
  "keywords": [
    "api",
    "developer-tools",
    "express",
    "runner",
    "trpc"
  ],
  "homepage": "https://github.com/farhan2077/trpc-runner#readme",
  "bugs": {
    "url": "https://github.com/farhan2077/trpc-runner/issues"
  },
  "license": "MIT",
  "author": "Farhan Bin Amin <farhanbinamin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhan2077/trpc-runner.git",
    "directory": "packages/trpc-runner"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/client/runner.css"
  ],
  "exports": {
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./style.css": "./dist/client/runner.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:client",
    "build:client": "vite build --config vite.client.config.ts",
    "build:server": "tsdown",
    "dev:client": "vite build --config vite.client.config.ts --watch --mode development",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@monaco-editor/react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "nuqs": "^2.8.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.11.2",
    "shadcn": "^4.12.0",
    "superjson": "^2.2.2",
    "tailwindcss": "^4.3.1",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@trpc/server": "^11.0.0"
  }
}
